# ──────────────────────────────────────────────────────────────────────────────
# Habla con tu dinero — configuración del backend
# Copia este archivo a .env y rellena los valores:  cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Proveedor de IA — descomenta UNO ──────────────────────────────────────────

# Opción A: Claude Sonnet via Anthropic API (recomendado para demo)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Opción B: Modelo local via Ollama
#   Arrancar con: docker compose --profile ollama up
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b

# Opción C: Groq (legado, modelo pequeño — menos preciso)
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
