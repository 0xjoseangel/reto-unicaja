# ══════════════════════════════════════════════════════════════════════════════
#  Habla con tu dinero — Configuración
#  Copia este fichero a .env y rellena solo el proveedor que uses.
#  Forma más fácil: ejecuta ./setup.sh desde la raíz del proyecto.
# ══════════════════════════════════════════════════════════════════════════════

# Modelo en formato litellm — descomenta el bloque del proveedor que quieras
LITELLM_MODEL=anthropic/claude-haiku-4-5

# ── Anthropic (Claude) ─────────────────────────────────────────────────────────
# Obtén tu key en: https://console.anthropic.com
# Modelos: claude-haiku-4-5 (rápido) | claude-sonnet-4-6 | claude-opus-4-8
# LITELLM_MODEL=anthropic/claude-haiku-4-5
ANTHROPIC_API_KEY=

# ── OpenAI ─────────────────────────────────────────────────────────────────────
# Obtén tu key en: https://platform.openai.com/api-keys
# Modelos: gpt-4o-mini (barato) | gpt-4o
# LITELLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=

# ── Groq (ultra-rápido, tier gratuito generoso) ────────────────────────────────
# Obtén tu key en: https://console.groq.com
# Modelos: llama-3.3-70b-versatile | llama-3.1-8b-instant | gemma2-9b-it
# LITELLM_MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=

# ── Google Gemini ───────────────────────────────────────────────────────────────
# Obtén tu key en: https://aistudio.google.com/apikey
# Modelos: gemini/gemini-2.0-flash | gemini/gemini-1.5-pro
# LITELLM_MODEL=gemini/gemini-2.0-flash
# GEMINI_API_KEY=

# ── Mistral ─────────────────────────────────────────────────────────────────────
# Obtén tu key en: https://console.mistral.ai
# Modelos: mistral/mistral-small-latest | mistral/mistral-large-latest
# LITELLM_MODEL=mistral/mistral-small-latest
# MISTRAL_API_KEY=

# ── Ollama (local, sin API key, privado) ────────────────────────────────────────
# Arrancar con: docker compose --profile ollama up -d
# setup.sh descarga el modelo automáticamente con ollama pull
# Modelos populares: llama3.2 | qwen2.5:7b | gemma3 | mistral | phi4
# LITELLM_MODEL=ollama/llama3.2
# LITELLM_API_BASE=http://ollama:11434

# ── Configuración interna (no tocar salvo que sepas lo que haces) ───────────────
DATABASE_URL=sqlite:////app/data/db.sqlite3
MODEL_CACHE_DIR=/app/models
